{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "oh-my-opencode-slim",
    "@slkiser/opencode-quota",
    "@mohak34/opencode-notifier@latest",
    "-graphify"
  ],
  "skills": [
    "~/.config/opencode/skills",
    "~/.config/skills"
  ],
  "instructions": [
    "~/.config/graphify/instructions.md"
  ],
  "mcp": {
    "graphify": {
      "type": "local",
      "command": ["graphify-mcp"],
      "enabled": true
    }
  },
  "agents": {
    "orchestrator": {
      "permissions": [
        { "action": "subagent", "resource": "orchestrator", "effect": "allow" },
        { "action": "subagent", "resource": "oracle", "effect": "allow" },
        { "action": "subagent", "resource": "librarian", "effect": "allow" },
        { "action": "subagent", "resource": "explorer", "effect": "allow" },
        { "action": "subagent", "resource": "designer", "effect": "allow" },
        { "action": "subagent", "resource": "fixer", "effect": "allow" },
        { "action": "subagent", "resource": "observer", "effect": "allow" }
      ]
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "permissions": [
    { "action": "subagent", "resource": "orchestrator", "effect": "deny" },
    { "action": "subagent", "resource": "oracle", "effect": "deny" },
    { "action": "subagent", "resource": "librarian", "effect": "deny" },
    { "action": "subagent", "resource": "explorer", "effect": "deny" },
    { "action": "subagent", "resource": "designer", "effect": "deny" },
    { "action": "subagent", "resource": "fixer", "effect": "deny" },
    { "action": "subagent", "resource": "observer", "effect": "deny" },
    { "action": "skill", "resource": "clonedeps", "effect": "deny" },
    { "action": "skill", "resource": "codemap", "effect": "deny" },
    { "action": "skill", "resource": "deepwork", "effect": "deny" },
    { "action": "skill", "resource": "oh-my-opencode-slim", "effect": "deny" },
    { "action": "skill", "resource": "reflect", "effect": "deny" },
    { "action": "skill", "resource": "simplify", "effect": "deny" },
    { "action": "skill", "resource": "verification-planning", "effect": "deny" },
    { "action": "skill", "resource": "worktrees", "effect": "deny" }
  ],
  "default_agent": "build",
  "lsp": true,
  "providers": {
    "openai": {},
    "copilot": {}
  }
}
