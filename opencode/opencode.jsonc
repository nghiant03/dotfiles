{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim@2.2.24",
    "@slkiser/opencode-quota",
    "@mohak34/opencode-notifier@latest"
  ],
  "skills": {
    "paths": [
      "~/.config/opencode/skills",
      "~/.config/skills"
    ]
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "default_agent": "build",
  "lsp": true,
  "provider": {
    "openai": {},
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {}
  }
}
