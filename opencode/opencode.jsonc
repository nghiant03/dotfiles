{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "skills": {
    "paths": [
      "~/.config/opencode/skills"
    ]
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "default_agent": "build",
  "lsp": true
}
