{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "plugins": [
    "oh-my-opencode-slim@2.2.24",
    "@slkiser/opencode-quota"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "permissions": "autoaccept"
  },
  "animations": true
}
